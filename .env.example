# ==================================================
# CareerForge AI — Environment Configuration Template
# Copy this file to .env and provide your local credentials
# ==================================================

# Database Configuration (PostgreSQL 16)
# Primary database URL using psycopg 3 driver
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careerforge

# Application Security
# Replace with a cryptographically random string (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-in-production-super-secret-key-careerforge-2026
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Anthropic Claude API Integration
# Obtain your key from: https://console.anthropic.com/
# If left blank, the backend operates in labelled demo mode for safe testing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Twilio Verify SMS Service
# Obtain credentials from: https://console.twilio.com/
# If left blank, local development simulated OTP challenge mode is enabled automatically
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
